{
	"name": "@lukisxyz/pi-core-goal",
	"version": "1.0.3",
	"type": "module",
	"description": "Session-log-backed long-running /goal mode for pi: automatic continuation after agent_settled, token budget, strict completion/blocked audits, cache-stable system prefix.",
	"license": "MIT",
	"author": "Pi Atelier contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lksxyz/pi-atelier.git",
		"directory": "packages/core/pi-core-goal"
	},
	"main": "./src/index.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run test",
		"check": "pnpm run typecheck && pnpm run test"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"goal"
	],
	"dependencies": {
		"effect": "^4.0.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"@types/node": "^22.12.0",
		"vitest": "^5.0.3"
	}

{
	"name": "pi-atelier",
	"version": "0.0.0",
	"packageManager": "pnpm@12.10.1",
	"description": "Monorepo for @lukisxyz pi extension packages (core + add) and the pi-toolset installer.",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"install:core": "node packages/pi-toolset/pi-toolset install",
		"pretypecheck": "node scripts/require-node.mjs",
		"prelint": "node scripts/require-node.mjs",
		"pretest": "node scripts/require-node.mjs",
		"typecheck": "pnpm -r --if-present --workspace-concurrency=1 run typecheck",
		"lint": "pnpm -r --if-present --workspace-concurrency=1 run lint",
		"test": "pnpm -r --if-present --workspace-concurrency=1 run test",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run test",
		"verify": "pnpm install --frozen-lockfile && pnpm run check",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@earendil-works/pi-agent-core": "^1.0.1",
		"@earendil-works/pi-ai": "^1.0.1",
		"@earendil-works/pi-coding-agent": "^1.0.1",
		"@earendil-works/pi-tui": "^1.0.1",
		"tsx": "^4.23.15",
		"typebox": "^1.3.27",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}